PORT=5002
# Local MongoDB or your Atlas connection string (mongodb+srv://USER:PASSWORD@HOST/morrow_notes?retryWrites=true&w=majority)
MONGODB_URI=mongodb://127.0.0.1:27017/morrow_notes

# Local development: put the Firebase Admin key at server/firebase-service-account.json
# (or point to it here). On a host, use FIREBASE_SERVICE_ACCOUNT_JSON instead.
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Only needed if the frontend is hosted on a different origin than the API (comma-separated)
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
